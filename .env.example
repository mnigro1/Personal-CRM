DATABASE_URL=
AUTH_SECRET=
# APP_URL=https://your-deployment.example
# MCP server workspace selection (local stdio server only):
MCP_USER_EMAIL=you@example.com

# Production REQUIRES one email provider — without one, sign-in refuses to
# send rather than print a live magic link into the server logs.
# Gmail SMTP (app password; sends to any recipient):
# GMAIL_USER=personalcrmapp@gmail.com
# GMAIL_APP_PASSWORD=16-char app password
# …or Resend (needs a verified sending domain to reach non-owner addresses):
# RESEND_API_KEY=
# EMAIL_FROM=crm@yourdomain.com
