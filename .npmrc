# next-auth 5 (beta) declares nodemailer ^7 || ^8 as an optional peer, but
# every nodemailer release below 10.1.4 carries open security advisories
# (address-parser recipient confusion, SMTP credential disclosure, DoS).
# We call nodemailer ourselves (src/auth.ts) with a plain SMTP transport, so
# the newer major is safe to use; this just stops npm refusing the tree.
# Drop once next-auth accepts nodemailer 10.
legacy-peer-deps=true
