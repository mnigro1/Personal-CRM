{
  "name": "personal-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "if [ -n \"$DATABASE_URL\" ]; then npm run db:migrate; else echo 'No DATABASE_URL in this environment - skipping migrations'; fi && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "mcp": "tsx mcp/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
